# Required: the base URL of the ComfyUI server (do not include credentials here).
Comfy_BASE_URL=http://127.0.0.1:8188

# Authentication is optional when ComfyUI is not protected.  `auto` sends a
# configured Bearer token and/or session cookie; use `none`, `bearer`, `cookie`,
# `x-api-key`, or `basic` when an explicit mode is needed.
Comfy_AUTH_MODE=auto

# Recommended for ComfyUI-Login: use the direct-API token printed when ComfyUI
# starts.  This is not the web-login password.
Comfy_API_KEY=

# Optional fallback for installations that authenticate requests with the
# AIOHTTP_SESSION cookie.  Enter either the cookie value or the full
# `AIOHTTP_SESSION=...` cookie pair.  This cookie may expire.
Comfy_AIOHTTP_SESSION=

# Only for a reverse proxy using HTTP Basic authentication.  The runner does
# not use these values to perform a ComfyUI web-form login.
Comfy_USERNAME=
Comfy_PASSWORD=
